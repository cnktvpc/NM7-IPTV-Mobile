<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#3A5878"/><corners android:radius="14dp"/><stroke android:width="3dp" android:color="@color/accent"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#334566"/><corners android:radius="14dp"/><stroke android:width="1dp" android:color="@color/accent"/></shape>
    </item>
    <item>
        <shape><solid android:color="#D914263C"/><corners android:radius="14dp"/><stroke android:width="1dp" android:color="#304B6887"/></shape>
    </item>
</selector>
