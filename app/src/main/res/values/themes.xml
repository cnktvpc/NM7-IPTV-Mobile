<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.IptvPlayer" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:alertDialogTheme">@style/Theme.Nm7.TransparentDialog</item>
    </style>

    <style name="Theme.Nm7.TransparentDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_translucent_bg</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
