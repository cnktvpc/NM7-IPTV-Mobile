<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="1dp" android:background="@drawable/channel_card"
    android:gravity="center_vertical" android:minHeight="66dp" android:orientation="horizontal"
    android:paddingHorizontal="6dp">

    <!-- Super OK displays a rectangular channel thumbnail, not a circular badge. -->
    <FrameLayout android:layout_width="58dp" android:layout_height="36dp">
        <TextView android:id="@+id/txtChannelBadge" android:layout_width="match_parent"
            android:layout_height="match_parent" android:background="@drawable/channel_badge"
            android:gravity="center" android:text="TV" android:textColor="@color/accent"
            android:textSize="15sp" android:textStyle="bold" />
        <ImageView android:id="@+id/imgChannelLogo" android:layout_width="match_parent"
            android:layout_height="match_parent" android:adjustViewBounds="true"
            android:contentDescription="Logo kênh" android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/txtName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
            android:textColor="@color/text_primary" android:textSize="15sp"
            android:textStyle="bold" />
        <TextView android:id="@+id/txtGroup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
            android:textColor="@color/accent" android:textSize="11sp" />
        <LinearLayout android:id="@+id/epgSection" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="1dp"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/txtProgramme" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
                android:textColor="@color/text_secondary" android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="1dp" android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView android:id="@+id/txtEpgStart" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                    android:textSize="9sp" />
                <ProgressBar android:id="@+id/epgProgress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp" android:layout_height="4dp" android:layout_marginHorizontal="5dp"
                    android:layout_weight="1" android:max="100" android:progressTint="@color/accent"
                    android:progressBackgroundTint="@color/text_secondary" />
                <TextView android:id="@+id/txtEpgEnd" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/txtUrl" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:ellipsize="middle" android:maxLines="1"
            android:textColor="@color/text_secondary" android:textSize="9sp" />
    </LinearLayout>

    <TextView android:id="@+id/btnFavorite" android:layout_width="36dp" android:layout_height="42dp"
        android:contentDescription="Thêm hoặc bỏ kênh yêu thích" android:focusable="false"
        android:gravity="center" android:text="☆" android:textColor="@color/warning"
        android:textSize="22sp" />
    <TextView android:layout_width="24dp" android:layout_height="42dp" android:gravity="center"
        android:text="▶" android:textColor="@color/accent" android:textSize="16sp" />
</LinearLayout>
