<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vlcRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/vlcVideoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#C007111F"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVlcBack"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:background="@drawable/button_secondary"
                android:text="‹"
                android:contentDescription="Quay lại danh sách"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/txtVlcTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtVlcStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VLC • đang mở luồng…"
            android:textColor="@color/accent"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/vlcError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="48dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/panel"
        android:padding="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtVlcError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/warning"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnVlcRetry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_primary"
            android:text="Thử lại"
            android:textAllCaps="false"
            android:textColor="@color/navy" />
    </LinearLayout>
</FrameLayout>
