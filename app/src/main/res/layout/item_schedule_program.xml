<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/channel_card"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:layout_marginBottom="4dp"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <!-- Thời gian phát sóng -->
    <LinearLayout
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:id="@+id/txtProgramTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtProgramDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Tên chương trình & mô tả -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/txtProgramTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtProgramDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Badge hoặc Nút hành động (Xem lại / Đang phát / Đang xem lại) -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="90dp">

        <!-- Nút Xem lại cho chương trình quá khứ -->
        <Button
            android:id="@+id/btnCatchupPlay"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:background="@drawable/button_secondary"
            android:backgroundTint="#FF9800"
            android:paddingHorizontal="10dp"
            android:text="↺ Xem lại"
            android:textAllCaps="false"
            android:textColor="#07111F"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Badge Đang phát -->
        <TextView
            android:id="@+id/badgeLive"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:background="@drawable/channel_badge"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="● ĐANG PHÁT"
            android:textColor="@color/live_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Badge Đang xem lại -->
        <TextView
            android:id="@+id/badgeReplaying"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:background="@drawable/channel_badge"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="● ĐANG XEM LẠI"
            android:textColor="#2196F3"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Trạng thái phụ (Đã hết / Sắp chiếu) -->
        <TextView
            android:id="@+id/txtProgramStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
