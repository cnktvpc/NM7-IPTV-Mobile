            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="@color/playback_divider" />
            <LinearLayout android:id="@+id/playback_description_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?android:attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingLeft="12dp" android:paddingTop="10dp" android:paddingEnd="8dp" android:paddingRight="8dp" android:paddingBottom="10dp" android:visibility="gone">
                <TextView android:id="@+id/playback_description_preview" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:textColor="#606060" android:textSize="13sp" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="8dp" android:layout_marginLeft="8dp" android:contentDescription="@null" android:src="@drawable/playback_ic_expand" />
