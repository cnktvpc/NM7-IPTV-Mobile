            <View android:id="@+id/playback_description_divider" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/playback_divider" android:visibility="gone" />
            <LinearLayout android:id="@+id/playback_comments_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="12dp" android:orientation="vertical" android:padding="12dp" android:background="@drawable/nm7_comment_card" android:visibility="gone" android:contentDescription="Mở bình luận" android:layout_marginTop="4dp" android:layout_marginBottom="14dp">
                <TextView android:id="@+id/nm7_comments_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bình luận" android:textColor="#0F0F0F" android:textStyle="bold" android:textSize="14sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
                    <ImageView android:id="@+id/nm7_comment_avatar" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/playback_channel_placeholder" android:contentDescription="@null" />
                    <TextView android:id="@+id/nm7_comment_preview" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:background="@android:color/transparent" android:padding="0dp" android:text="Đang tải bình luận…" android:textColor="#606060" android:maxLines="2" android:ellipsize="end" android:textSize="12sp" />
