                    <com.google.android.material.button.MaterialButton android:textColor="#0F0F0F" android:id="@+id/playback_chip_speed" style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon" android:layout_width="48dp" android:layout_height="32dp" android:layout_marginStart="4dp" android:layout_marginLeft="4dp" android:layout_marginEnd="4dp" android:layout_marginRight="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:contentDescription="@string/action_video_speed" app:icon="@drawable/playback_ic_speed" app:iconGravity="textStart" app:iconPadding="6dp" app:iconSize="18dp" app:iconTint="#0F0F0F" android:minHeight="32dp" android:textAllCaps="false" android:paddingStart="10dp" android:paddingEnd="10dp" app:cornerRadius="16dp" app:strokeWidth="0dp" app:backgroundTint="#F1F1F1" android:textSize="12sp" android:letterSpacing="0" android:paddingLeft="10dp" android:paddingRight="10dp" />
                    <com.google.android.material.button.MaterialButton android:textColor="#0F0F0F" android:id="@+id/playback_chip_more" style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon" android:layout_width="48dp" android:layout_height="32dp" android:layout_marginStart="4dp" android:layout_marginLeft="4dp" android:layout_marginEnd="4dp" android:layout_marginRight="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:contentDescription="@string/playback_more" app:icon="@drawable/playback_ic_more" app:iconGravity="textStart" app:iconPadding="6dp" app:iconSize="18dp" app:iconTint="#0F0F0F" android:minHeight="32dp" android:textAllCaps="false" android:paddingStart="10dp" android:paddingEnd="10dp" app:cornerRadius="16dp" app:strokeWidth="0dp" app:backgroundTint="#F1F1F1" android:textSize="12sp" android:letterSpacing="0" android:paddingLeft="10dp" android:paddingRight="10dp" />
                </LinearLayout>
